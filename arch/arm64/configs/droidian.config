# --- Halium / Droidian Core ---

CONFIG_ANDROID=y

CONFIG_ANDROID_BINDER_IPC=y

CONFIG_ANDROID_BINDERFS=y

CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"

CONFIG_ASHMEM=y

CONFIG_ION=y

CONFIG_SW_SYNC=y

CONFIG_SYNC_FILE=y


# --- Namespaces & Cgroups ---

CONFIG_NAMESPACES=y

CONFIG_UTS_NS=y

CONFIG_IPC_NS=y

CONFIG_USER_NS=y

CONFIG_PID_NS=y

CONFIG_NET_NS=y

CONFIG_CGROUPS=y

CONFIG_CGROUP_FREEZER=y

CONFIG_CGROUP_DEVICE=y

CONFIG_CGROUP_CPUACCT=y

CONFIG_CGROUP_SCHED=y

CONFIG_CPUSETS=y

CONFIG_MEMCG=y

CONFIG_BLK_CGROUP=y


# --- Filesystem Support ---

CONFIG_EXT4_FS=y

CONFIG_EXT4_FS_POSIX_ACL=y

CONFIG_EXT4_FS_SECURITY=y

CONFIG_FUSE_FS=y

CONFIG_OVERLAY_FS=y

CONFIG_TMPFS=y

CONFIG_TMPFS_POSIX_ACL=y

CONFIG_TMPFS_XATTR=y


# --- Networking Essentials ---

CONFIG_PACKET=y

CONFIG_UNIX=y

CONFIG_INET=y

CONFIG_IPV6=y

CONFIG_NETFILTER=y

CONFIG_NETFILTER_ADVANCED=y

CONFIG_BRIDGE=y

CONFIG_VETH=y

CONFIG_TUN=y


# --- Input & HID ---

CONFIG_INPUT_EVDEV=y

CONFIG_INPUT_UINPUT=y

CONFIG_HID_MULTITOUCH=y


# --- Debugging & DevFS ---

CONFIG_KALLSYMS=y

CONFIG_KALLSYMS_ALL=y

CONFIG_DEBUG_FS=y

CONFIG_PROC_FS=y

CONFIG_SYSFS=y

CONFIG_DEVTMPFS=y

CONFIG_DEVTMPFS_MOUNT=y
